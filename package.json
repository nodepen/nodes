{
    "name": "@nodepen/nodes",
    "private": true,
    "version": "1.0.0",
    "description": "same grasshopper, new digs",
    "author": "@cdriesler",
    "repository": {
        "type": "git",
        "url": "https://github.com/nodepen/nodes.git"
    },
    "packageManager": "npm@10.9.0",
    "license": "MIT",
    "files": [
        "dist/**/*"
    ],
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.mts"
        },
        "./constants": {
            "import": "./dist/constants.mjs",
            "types": "./dist/constants.d.mts"
        },
        "./utils": {
            "import": "./dist/utils/index.mjs",
            "types": "./dist/utils/index.d.mts"
        },
        "./styles.css": "./dist/styles.css"
    },
    "overrides": {
        "esbuild": "^0.28.2"
    },
    "scripts": {
        "postbuild": "tailwindcss build -i tailwind.css -o dist/styles.css && node postbuild.js",
        "build": "tsup",
        "compile": "tsc",
        "dev": "rm -rf dist && tsup --watch",
        "preview": "vite --config dev/vite.config.ts",
        "lint": "eslint --ext .ts,.tsx .",
        "lint:fix": "eslint --fix --ext .ts,.tsx .",
        "test": "jest"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.0",
        "immer": "^10.1.1",
        "meshline": "^3.3.1",
        "react-hook-form": "^7.72.1",
        "three": "^0.185.1",
        "zustand": "4.5.5"
    },
    "peerDependencies": {
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/three": "^0.185.4",
        "@typescript-eslint/eslint-plugin": "^7.5.0",
        "@typescript-eslint/parser": "^7.5.0",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.4.20",
        "concurrently": "^10.0.4",
        "copyfiles": "^2.4.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-prettier": "^5.1.3",
        "postcss": "^8.4.47",
        "prettier": "^3.2.5",
        "tailwindcss": "^3.4.14",
        "ts-jest": "^29.1.4",
        "tsc-alias": "^1.8.10",
        "tsc-watch": "^7.2.1",
        "tsup": "^8.5.1",
        "typescript": "6.0.3",
        "vite": "^8.2.1"
    }
}
{
  "name": "@nodepen/nodes",
  "private": true,
  "version": "1.0.0",
  "description": "same grasshopper, new digs",
  "author": "@cdriesler",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodepen/nodes.git"
  },
  "packageManager": "npm@10.9.0",
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],

      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "postbuild": "tailwindcss build -i tailwind.css -o dist/styles.css",
    "build": "tsup",
